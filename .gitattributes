# 统一行尾与文本判定 —— 避免 Windows/Linux 贡献者之间产生整文件 diff 噪音
* text=auto eol=lf

# Windows 批处理保留 CRLF（cmd.exe 对 LF-only 的 label/goto 有已知边界问题）
*.cmd text eol=crlf
*.bat text eol=crlf

# ── 二进制（仓库坚持「零素材」，这里只是兜底）────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
*.7z    binary
